# Safe local development defaults. Copy to backend/.env for local use.
APP_NAME=AskHype API
APP_ENV=development
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated allowlist; combined with FRONTEND_ORIGIN when both are set.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Used once only after the primary model exhausts transient 503 retries.
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_SECONDS=45
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=4096
# Optional preview agent ID enabling asynchronous Deep Research.
# Example IDs change during preview; use a currently supported ID from Google's docs.
GEMINI_RESEARCH_MODEL=
RESEARCH_DAILY_LIMIT=3
RESEARCH_MAX_DEPTH=standard
# Optional; falls back to GEMINI_MODEL when empty.
GEMINI_ANIMATION_MODEL=
ANIMATION_DAILY_LIMIT=10

QUOTA_ENFORCEMENT_ENABLED=false
ANONYMOUS_PROMPT_LIMIT=5
FREE_ROLLING_24H_PROMPT_LIMIT=10
PREMIUM_ROLLING_24H_PROMPT_LIMIT=200
MOCK_SUBSCRIPTIONS_ENABLED=true

# Backend-only Supabase and identity secrets. Never expose these as VITE_ variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANONYMOUS_ID_PEPPER=

# Production must override at least:
# APP_ENV=production
# AI_PROVIDER=gemini
# QUOTA_ENFORCEMENT_ENABLED=true
# MOCK_SUBSCRIPTIONS_ENABLED=false
# FRONTEND_ORIGIN=https://your-frontend.example
# GEMINI_API_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY, ANONYMOUS_ID_PEPPER
